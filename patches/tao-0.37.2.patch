diff --git a/src/platform_impl/linux/channel.rs b/src/platform_impl/linux/channel.rs
new file mode 100644
index 0000000..af58ca4
--- /dev/null
+++ b/src/platform_impl/linux/channel.rs
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! A channel whose receiving end runs on a GTK main context: what any
+//! thread sends is passed, in order, to a closure on the context's thread.
+
+use gtk::glib::{ControlFlow, MainContext};
+
+/// The sending end; a clone sends to the same receiver.
+pub struct Sender<T>(async_channel::Sender<T>);
+
+impl<T> Clone for Sender<T> {
+  fn clone(&self) -> Self {
+    Self(self.0.clone())
+  }
+}
+
+impl<T> Sender<T> {
+  /// Queues `message` for the receiving end; fails once that end has stopped.
+  pub fn send(&self, message: T) -> Result<(), async_channel::TrySendError<T>> {
+    self.0.try_send(message)
+  }
+}
+
+/// The receiving end, until it is attached to a main context.
+pub struct Receiver<T>(async_channel::Receiver<T>);
+
+impl<T: 'static> Receiver<T> {
+  /// Passes each message to `on_message` on `context`, or on the thread's
+  /// default context when `None`, until it returns `Break` or every sender
+  /// is dropped. Called on the thread that owns the context.
+  pub fn attach(
+    self,
+    context: Option<&MainContext>,
+    mut on_message: impl FnMut(T) -> ControlFlow + 'static,
+  ) {
+    let context = context
+      .cloned()
+      .unwrap_or_else(MainContext::ref_thread_default);
+    let receiver = self.0;
+    context.spawn_local(async move {
+      loop {
+        match receiver.recv().await {
+          Ok(message) => {
+            if on_message(message).is_break() {
+              break;
+            }
+          }
+          // Every sender is dropped, so no message can arrive.
+          Err(async_channel::RecvError) => break,
+        }
+      }
+    });
+  }
+}
+
+/// A channel without a bound.
+pub fn channel<T>() -> (Sender<T>, Receiver<T>) {
+  let (sender, receiver) = async_channel::unbounded();
+  (Sender(sender), Receiver(receiver))
+}
