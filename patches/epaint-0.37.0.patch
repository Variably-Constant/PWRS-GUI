+/// Writes a glyph's outline as [`OutlineSegment`]s, its origin at `origin`,
+/// y growing downward.
+struct SegmentPen<'a> {
+    origin: Pos2,
+    out: &'a mut Vec<OutlineSegment>,
+}
+
+impl SegmentPen<'_> {
+    fn at(&self, x: f32, y: f32) -> Pos2 {
+        pos2(self.origin.x + x, self.origin.y - y)
+    }
+}
+
+impl skrifa::outline::OutlinePen for SegmentPen<'_> {
+    fn move_to(&mut self, x: f32, y: f32) {
+        let to = self.at(x, y);
+        self.out.push(OutlineSegment::MoveTo(to));
+    }
+
+    fn line_to(&mut self, x: f32, y: f32) {
+        let to = self.at(x, y);
+        self.out.push(OutlineSegment::LineTo(to));
+    }
+
+    fn quad_to(&mut self, cx0: f32, cy0: f32, x: f32, y: f32) {
+        let (control, to) = (self.at(cx0, cy0), self.at(x, y));
+        self.out.push(OutlineSegment::QuadTo(control, to));
+    }
+
+    fn curve_to(&mut self, cx0: f32, cy0: f32, cx1: f32, cy1: f32, x: f32, y: f32) {
+        let (first, second, to) = (self.at(cx0, cy0), self.at(cx1, cy1), self.at(x, y));
+        self.out.push(OutlineSegment::CubicTo(first, second, to));
+    }
+
+    fn close(&mut self) {
+        self.out.push(OutlineSegment::Close);
+    }
+}
