+impl GlyphSource {
+    /// The source of glyph `glyph_id` of `face`, drawn with `metrics`, its
+    /// origin `x_px` and `y_px` physical pixels from where the glyph is
+    /// placed, as the shaper offsets it.
+    pub(crate) fn new(face: FontFaceKey, glyph_id: skrifa::GlyphId, metrics: &StyledMetrics, x_px: f32, y_px: f32) -> Self {
+        let ppp = metrics.pixels_per_point;
+        Self {
+            face,
+            glyph_id: glyph_id.to_u32(),
+            size: metrics.scale / ppp,
+            origin: vec2(x_px / ppp, metrics.y_offset_in_points + y_px / ppp),
+        }
+    }
+}
