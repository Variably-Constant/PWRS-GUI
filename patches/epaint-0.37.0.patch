+    /// The outlines of `galley`'s glyphs as their faces draw them unhinted,
+    /// in points from the galley's top left, y growing downward, each
+    /// contour opened by a [`OutlineSegment::MoveTo`], and how many of its
+    /// glyphs could not be outlined: one drawn as a bitmap, a color glyph or
+    /// a rasterizer's, one whose face is no longer among these fonts, as
+    /// once [`Fonts::begin_pass`] has made them anew, or one whose face has
+    /// no outline for it. `coords` are the variation coordinates the
+    /// galley's text was formatted with.
+    pub fn galley_outlines(
+        &self,
+        galley: &Galley,
+        coords: &VariationCoords,
+    ) -> (Vec<OutlineSegment>, usize) {
+        let mut out = Vec::new();
+        let mut missed = 0;
+        for placed in &galley.rows {
+            for glyph in &placed.row.glyphs {
+                match &glyph.source {
+                    Some(source) if !glyph.is_color => {
+                        let origin = placed.pos + glyph.pos.to_vec2() + source.origin;
+                        let drawn = self
+                            .fonts
+                            .face(source.face)
+                            .is_some_and(|face| face.outline_into(source, coords, origin, &mut out));
+                        if !drawn {
+                            missed += 1;
+                        }
+                    }
+                    _ if glyph.uv_rect.is_nothing() => {}
+                    _ => missed += 1,
+                }
+            }
+        }
+        (out, missed)
+    }
 }
 
