+/// Calls org.freedesktop.portal.Request.Close on the request at
+/// `handle_path`, on the connection that made it.
+fn close_request(conn: &mut Connection, handle_path: &CStr) {
+    let Some(close) = Message::new_method_call(
+        c"org.freedesktop.portal.Desktop",
+        handle_path,
+        c"org.freedesktop.portal.Request",
+        c"Close",
+    ) else {
+        log::error!("Request.Close could not be made");
+        return;
+    };
+    let reply = conn.send_and_block(&close);
+    if conn.err().is_err() || reply.is_none() {
+        log::error!("Request.Close failed: {}", conn.err());
+    }
