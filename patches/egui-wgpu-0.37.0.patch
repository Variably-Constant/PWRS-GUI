+    /// Whether a configure of this surface has succeeded. wgpu panics when a frame is
+    /// requested of a surface none has set up, so until then a paint skips its frame.
+    configured: bool,
+
+    /// The frames skipped in a row because the surface was not configured, which space
+    /// out the configures that follow them.
+    unconfigured_paints: u32,
+}
+
+/// How many times [`Painter::configure_surface`] configures a surface while another
+/// thread's submissions repeatedly cut its wait for an idle GPU short.
+const CONFIGURE_TRIES: u32 = 8;
+
+/// The size of the staging write [`device_lost`] makes.
+const PROBE_SIZE: NonZeroU64 = NonZeroU64::MIN.saturating_add(3);
+
+/// Whether `device` is lost. wgpu reports a lost device's errors to no error scope, so a
+/// configure on one seems to succeed while leaving the surface with nothing to present;
+/// a staging write to a buffer made for it, which wgpu refuses on a lost device, tells
+/// the two apart.
+fn device_lost(device: &wgpu::Device, queue: &wgpu::Queue) -> bool {
+    let probe = device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("egui_device_probe"),
+        size: PROBE_SIZE.get(),
+        usage: wgpu::BufferUsages::COPY_DST,
+        mapped_at_creation: false,
+    });
+    queue.write_buffer_with(&probe, 0, PROBE_SIZE).is_none()
+}
+
+/// Whether `error` is wgpu-core's refusal of a surface configure whose wait for an
+/// idle GPU did not end with the queue empty: another thread submitted work while it
+/// waited, or the wait timed out.
+fn wait_cut_short(error: &wgpu::Error) -> bool {
+    core::iter::successors(Some(error as &(dyn std::error::Error + 'static)), |e| {
+        e.source()
+    })
+    .any(|e| {
+        matches!(
+            e.downcast_ref::<wgpu::wgc::present::ConfigureSurfaceError>(),
+            Some(wgpu::wgc::present::ConfigureSurfaceError::GpuWaitTimeout)
+        )
+    })
+}
+
+/// Submits the work a frame's paint callbacks prepared, with the encoder they prepared it
+/// into, for a paint that ends before its render pass. A callback may count on what it
+/// prepared having run, as one that keeps a drawing of its own between frames does.
+fn submit_prepared(
+    queue: &wgpu::Queue,
+    user_cmd_bufs: Vec<wgpu::CommandBuffer>,
+    encoder: wgpu::CommandEncoder,
+) {
+    queue.submit(core::iter::chain(user_cmd_bufs, [encoder.finish()]));
 }
 
